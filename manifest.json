{
  "manifest_version": 3,
  "name": "Cookie Share Next",
  "version": "0.1.0",
  "description": "Zero-knowledge cookie buckets with client-side encryption.",
  "permissions": ["cookies", "storage", "tabs", "downloads", "identity"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Cookie Share Next"
  }
}
